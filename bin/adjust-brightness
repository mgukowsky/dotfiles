#!/bin/bash
if [[ "$#" -ne 1 || ! "$1" =~ ^[+-]$ ]]; then
  echo "Usage: $0 +|-"
  exit 1
fi

if [ "$1" == "+" ]; then
  brightnessctl set +5%
else
  brightnessctl set 5%-
fi

brightness=$(brightnessctl get)
max_brightness=$(brightnessctl max)
percent=$((brightness * 100 / max_brightness))

declare -r NOTIFICATION_ID=$(printf '%d\n' 0x$(printf %s "brightness" | md5sum | cut -c1-4))
notify-send -r $NOTIFICATION_ID -h int:value:$percent -h string:synchronous:my-notification " Brightness: $percent%"
